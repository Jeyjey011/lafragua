<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>LA FRAGUA</string>

    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>

    <!-- Solo iPhone y solo vertical: la app está diseñada para 9:16. -->
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>

    <!-- Fondo oscuro fijo: el HTML es oscuro, y con la barra clara se ve mal. -->
    <key>UIUserInterfaceStyle</key>
    <string>Dark</string>
    <key>UIStatusBarStyle</key>
    <string>UIStatusBarStyleLightContent</string>

    <!-- El único permiso que pide, y solo al pulsar "Guardar en Fotos". -->
    <key>NSPhotoLibraryAddUsageDescription</key>
    <string>Para dejar en tu carrete las imágenes y videos que generas, y que puedas subirlos a tus anuncios.</string>

    <!-- Evita que App Store Connect pregunte por cifrado en cada envío.
         Es cierto: la app solo usa HTTPS estándar del sistema. -->
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
</dict>
</plist>
